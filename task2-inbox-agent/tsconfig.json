{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "outDir": "dist", "rootDir": "src",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": false,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true, "skipLibCheck": true
  },
  "include": ["src"]
}
