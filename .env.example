# Copy to .env (run.sh loads it). Everything runs WITHOUT a key in offline mode.
ANTHROPIC_API_KEY=
# Model routing is justified by EVALS §5 — change here, re-run evals, record numbers.
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5
KNOWLEDGE_BRAIN_URL=http://127.0.0.1:8000
